---
// The landing page at /ruru/: the hero with a live-looking wall, what Ruru
// does, how it works and the downloads. Docs and reference pages stay in
// Starlight.
import LandingLayout from '../components/landing/LandingLayout.astro';
import ControlRoom from '../components/landing/ControlRoom.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const releases = 'https://github.com/kerwincarpede/ruru/releases/latest';

const features = [
	{
		title: 'Sync from Frigate',
		body: 'Connect once and Ruru reads the camera list for you. Add a camera to Frigate and it shows up on the wall. No stream URLs to copy, no camera passwords to type in twice.',
		href: `${base}/get-started/connect/`,
	},
	{
		title: 'Live, with as little delay as possible',
		body: "Video plays straight from Frigate's go2rtc restreamer over WebRTC, with MSE as the fallback. Small tiles play the sub stream and big ones the main stream, picked for you.",
		href: `${base}/wall/streams/`,
	},
	{
		title: 'Arrange your wall',
		body: 'Drag tiles to move them and pull their corners to resize them on a snapping grid. Make the front door big and the side gate small. Ruru remembers it for each server.',
		href: `${base}/wall/arrange/`,
	},
	{
		title: "Built for a screen that's always on",
		body: 'Runs full screen on a spare monitor or a wall display, reconnects on its own when a camera or the network drops, and marks a frozen picture with how old it is.',
		href: `${base}/wall/watch/`,
	},
];

const platforms = [
	{ name: 'Windows', detail: '10 or 11', files: '-setup.exe or .msi' },
	{ name: 'macOS', detail: 'Apple silicon only', files: 'aarch64 .dmg' },
	{ name: 'Linux', detail: 'x86_64 and arm64', files: '.deb, .rpm or .AppImage' },
];
---

<LandingLayout
	title="Ruru: Eyes on every camera."
	description="A fast, free, low-latency camera wall for Frigate, on Windows, macOS and Linux."
>
	<ControlRoom />

	<section class="steps" aria-labelledby="steps-title">
		<h2 id="steps-title" class="ru-h2"><span>Three steps.</span><span>Then just watch.</span></h2>
		<ol>
			<li>
				<b>Enter your Frigate address.</b>
				<span>Such as <code>http://frigate.local:5000</code>. <strong>Test connection</strong> checks it first.</span>
			</li>
			<li>
				<b>Every camera appears.</b>
				<span>Live, within a second or two, straight from Frigate's own restreamer.</span>
			</li>
			<li>
				<b>Drag and resize.</b>
				<span>Make the wall look right, then choose <strong>Done</strong>. Ruru remembers it.</span>
			</li>
		</ol>
	</section>

	<section id="features" class="features" aria-labelledby="features-title">
		<h2 id="features-title" class="ru-h2"><span>Built for one job.</span><span>Watching every camera at once.</span></h2>
		<p class="ru-lede">
			Frigate is great at recording and detecting. Ruru is for the spare monitor or the wall display, without a browser tab full
			of lagging tiles.
		</p>
		<div class="grid">
			{
				features.map((feature) => (
					<a class="card" href={feature.href}>
						<h3>{feature.title}</h3>
						<p>{feature.body}</p>
						<span class="more">Learn more →</span>
					</a>
				))
			}
		</div>
	</section>

	<section class="private" aria-labelledby="private-title">
		<h2 id="private-title" class="ru-h2"><span>Your cameras stay yours.</span></h2>
		<p class="ru-lede">
			Ruru talks to your Frigate server and checks GitHub for updates. That's all. No analytics, no telemetry, no cloud account,
			and video goes from Frigate to the screen without passing through anything else.
		</p>
		<p class="center"><a href={`${base}/reference/privacy/`}>How Ruru works and what it sends →</a></p>
	</section>

	<section id="download" class="download" aria-labelledby="download-title">
		<h2 id="download-title" class="ru-h2"><span>Get Ruru.</span><span>Free and open source.</span></h2>
		<div class="platforms">
			{
				platforms.map((platform) => (
					<a class="platform" href={releases}>
						<b>{platform.name}</b>
						<span>{platform.detail}</span>
						<code>{platform.files}</code>
					</a>
				))
			}
		</div>
		<p class="center muted">Or install on Linux with one command:</p>
		<pre class="cmd"><code>curl -fsSL https://raw.githubusercontent.com/kerwincarpede/ruru/main/install.sh | sh</code></pre>
		<div class="actions">
			<a class="ru-btn" href={releases}>Download the latest release</a>
			<a class="ru-btn ru-btn--ghost" href={`${base}/get-started/install/`}>Install guide</a>
		</div>
	</section>
</LandingLayout>

<style>
	section {
		max-width: 1180px;
		margin: 0 auto;
		padding: clamp(72px, 10vw, 128px) clamp(16px, 4vw, 40px) 0;
		box-sizing: border-box;
	}

	.steps ol {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		margin: 48px 0 0;
		padding: 0;
		list-style: none;
		counter-reset: step;
	}
	.steps li {
		counter-increment: step;
		display: flex;
		flex-direction: column;
		gap: 8px;
		padding: 24px;
		border-radius: 16px;
		background: var(--ru-glass);
		box-shadow: inset 0 0 0 1px var(--ru-hair);
	}
	.steps li::before {
		content: counter(step);
		display: grid;
		place-items: center;
		width: 32px;
		height: 32px;
		margin-bottom: 6px;
		border-radius: 50%;
		background: var(--ru-accent-soft);
		color: var(--ru-accent);
		font-weight: 700;
	}
	.steps b {
		font-size: 19px;
		letter-spacing: -0.01em;
	}
	.steps li span {
		color: var(--ru-muted);
	}
	.steps code,
	.platform code {
		font-size: 0.88em;
	}

	.grid {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 16px;
		margin-top: 48px;
	}
	.card {
		display: flex;
		flex-direction: column;
		padding: 28px;
		border-radius: 18px;
		background: var(--ru-glass);
		box-shadow: inset 0 0 0 1px var(--ru-hair);
		text-decoration: none;
		transition: box-shadow 0.2s ease;
	}
	.card:hover {
		box-shadow: inset 0 0 0 1px var(--ru-accent-edge);
	}
	.card h3 {
		margin: 0 0 10px;
		font-size: 22px;
		letter-spacing: -0.02em;
		font-weight: 650;
	}
	.card p {
		margin: 0 0 18px;
		color: var(--ru-muted);
	}
	.more {
		margin-top: auto;
		color: var(--ru-accent);
		font-weight: 600;
		font-size: 15px;
	}

	.center {
		text-align: center;
	}
	.private a {
		color: var(--ru-accent);
		font-weight: 600;
		text-decoration: none;
	}
	.muted {
		color: var(--ru-muted);
	}

	.download {
		padding-bottom: clamp(72px, 10vw, 128px);
	}
	.platforms {
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 16px;
		margin: 48px 0 36px;
	}
	.platform {
		display: flex;
		flex-direction: column;
		gap: 4px;
		padding: 24px;
		border-radius: 16px;
		background: var(--ru-glass);
		box-shadow: inset 0 0 0 1px var(--ru-hair);
		text-decoration: none;
		transition: box-shadow 0.2s ease;
	}
	.platform:hover {
		box-shadow: inset 0 0 0 1px var(--ru-accent-edge);
	}
	.platform b {
		font-size: 22px;
		letter-spacing: -0.02em;
	}
	.platform span {
		color: var(--ru-muted);
	}
	.platform code {
		margin-top: 10px;
		color: var(--ru-accent);
	}
	.cmd {
		max-width: 760px;
		margin: 12px auto 0;
		padding: 16px 20px;
		border-radius: 12px;
		background: var(--ru-code-bg);
		box-shadow: inset 0 0 0 1px var(--ru-hair);
		overflow-x: auto;
		font-size: 14px;
	}

	@media (max-width: 820px) {
		.steps ol,
		.platforms {
			grid-template-columns: 1fr;
		}
		.grid {
			grid-template-columns: 1fr;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.card,
		.platform {
			transition: none;
		}
	}
</style>
