---
// The Ruru owl on its night tile, as in the app icon
// (src/ruru/src-tauri/icons/source/app-icon.svg). Each use passes its own id,
// so the gradients on one page don't clash.
interface Props {
	size?: number;
	id: string;
}
const { size = 26, id } = Astro.props;
---

<svg width={size} height={size} viewBox="32 32 960 960" aria-hidden="true" class="ru-logo">
	<defs>
		<linearGradient id={`${id}-tile`} x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#2a2f3a"></stop>
			<stop offset="1" stop-color="#14171d"></stop>
		</linearGradient>
		<linearGradient id={`${id}-body`} x1="0" y1="0" x2="0" y2="1">
			<stop offset="0" stop-color="#c98a3e"></stop>
			<stop offset="1" stop-color="#8a5523"></stop>
		</linearGradient>
	</defs>
	<rect x="32" y="32" width="960" height="960" rx="220" fill={`url(#${id}-tile)`}></rect>
	<circle cx="760" cy="250" r="96" fill="#f3e6c8" opacity="0.18"></circle>
	<path d="M262 214 L380 318 Q512 270 644 318 L762 214 L770 500 Q790 846 512 880 Q234 846 254 500 Z" fill={`url(#${id}-body)`}></path>
	<path d="M512 610 Q420 640 400 760 Q512 840 624 760 Q604 640 512 610 Z" fill="#f1dfc4" opacity="0.35"></path>
	<circle cx="400" cy="474" r="128" fill="#f1dfc4"></circle>
	<circle cx="624" cy="474" r="128" fill="#f1dfc4"></circle>
	<circle cx="400" cy="474" r="80" fill="#f2b631"></circle>
	<circle cx="624" cy="474" r="80" fill="#f2b631"></circle>
	<circle cx="400" cy="474" r="44" fill="#14171d"></circle>
	<circle cx="624" cy="474" r="44" fill="#14171d"></circle>
	<circle cx="418" cy="456" r="13" fill="#ffffff"></circle>
	<circle cx="642" cy="456" r="13" fill="#ffffff"></circle>
	<path d="M478 560 L546 560 L512 632 Z" fill="#3a2a1a"></path>
</svg>
