---
// Ruru's device as a Home Assistant dashboard shows it, with an automation
// that maximises the front door during an alert. Its values change in step
// with the wall (see HeroWall.astro).
---

<div class="ha" role="group" aria-label="Home Assistant: the Ruru device and an automation">
	<div class="ha-hd">
		<span class="ha-ic"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"></rect><path d="M9 20h6M12 16v4"></path></svg></span>
		<div><b>Ruru on kitchen-pi</b><span>MQTT device</span></div>
	</div>
	<div class="ha-r">
		<span>Maximise</span>
		<span class="ha-sel ha-stack"><span class="v-none">none</span><span class="v-fd">Front door</span></span>
	</div>
	<div class="ha-r"><span>Full screen</span><i class="tg" aria-label="On"></i></div>
	<div class="ha-r"><span>Streams</span><i class="tg" aria-label="On"></i></div>
	<div class="ha-r"><span>Display</span><i class="tg" aria-label="On"></i></div>
	<div class="ha-r"><span>Front door problem</span><span class="v-ok">OK</span></div>
	<div class="ha-r">
		<span>Front door person <small>Frigate</small></span>
		<span class="ha-stack"><span class="v-clear">Clear</span><span class="v-det">Detected</span></span>
	</div>
	<div class="ha-auto">
		<b>Automation</b>
		When the front door raises an alert, maximise it on the wall. Restore when it ends.
		<div class="ha-run"><i></i><span class="ha-stack"><span class="r-old">Last ran yesterday</span><span class="r-new">Ran just now</span></span></div>
	</div>
</div>

<style>
	/* ---------- Home Assistant card ---------- */

	.ha { box-sizing: border-box; width: 100%; padding: 16px; border: 1px solid var(--ru-hair-strong); border-radius: 18px; background: rgba(20, 22, 27, 0.92); backdrop-filter: blur(14px); box-shadow: 0 30px 80px -24px rgba(0, 0, 0, 0.85); font-family: var(--ru-font-sans); color: var(--ru-text); }
	.ha-hd { display: flex; align-items: center; gap: 11px; margin-bottom: 10px; }
	.ha-ic { display: grid; place-items: center; flex: none; width: 36px; height: 36px; border-radius: 11px; background: rgba(143, 184, 255, 0.12); }
	.ha-ic svg { width: 19px; height: 19px; fill: none; stroke: #8fb8ff; stroke-width: 1.8; stroke-linecap: round; stroke-linejoin: round; }
	.ha-hd b { display: block; font-size: 14.5px; font-weight: 620; }
	.ha-hd span { display: block; margin-top: 1px; color: var(--ru-muted); font-size: 12px; }
	.ha-r { display: flex; align-items: center; justify-content: space-between; gap: 12px; min-height: 40px; border-top: 1px solid var(--ru-hair); font-size: 13.5px; }
	.ha-r > span:first-child { color: #cfc9bf; }
	.ha-r small { margin-left: 4px; color: var(--ru-muted); font-size: 11px; }
	.ha-stack { display: grid; justify-items: end; }
	.ha-stack > span { grid-area: 1 / 1; white-space: nowrap; }
	.ha-sel { padding: 5px 10px; border-radius: 8px; background: rgba(255, 255, 255, 0.06); font-size: 12.5px; font-weight: 560; }
	.v-none { animation: cr-ha-none var(--loop) linear infinite; }
	.v-fd { color: #ffb0b2; opacity: 0; animation: cr-ha-fd var(--loop) linear infinite; }
	.v-clear { color: var(--ru-muted); animation: cr-ha-clear var(--loop) linear infinite; }
	.v-det { color: #e8b73f; font-weight: 600; opacity: 0; animation: cr-ha-det var(--loop) linear infinite; }
	.v-ok { color: #4ade80; font-weight: 560; }
	.tg { position: relative; flex: none; width: 34px; height: 20px; border-radius: 99px; background: #e0a458; }
	.tg::after { content: ''; position: absolute; top: 3px; right: 3px; width: 14px; height: 14px; border-radius: 50%; background: #15171c; }
	.ha-auto { margin-top: 8px; padding: 11px 12px; border-radius: 12px; background: rgba(255, 255, 255, 0.04); border: 1px solid var(--ru-hair); font-size: 12.5px; line-height: 1.45; color: #cfc9bf; }
	.ha-auto b { display: block; margin-bottom: 3px; color: var(--ru-text); font-size: 12px; font-weight: 600; letter-spacing: 0.04em; text-transform: uppercase; }
	.ha-run { display: inline-flex; align-items: center; gap: 6px; margin-top: 7px; color: var(--ru-muted); font-size: 12px; }
	.ha-run i { width: 7px; height: 7px; border-radius: 50%; background: #5c5850; animation: cr-ha-run var(--loop) linear infinite; }
	.ha-run .ha-stack { justify-items: start; }
	.r-old { animation: cr-ha-clear-b var(--loop) linear infinite; }
	.r-new { color: #8fb8ff; opacity: 0; animation: cr-ha-run-t var(--loop) linear infinite; }

	@keyframes cr-ha-none { 0%, 35.3% { opacity: 1; } 35.8%, 57.8% { opacity: 0; } 58.3%, 100% { opacity: 1; } }
	@keyframes cr-ha-fd { 0%, 35.3% { opacity: 0; } 35.8%, 57.8% { opacity: 1; } 58.3%, 100% { opacity: 0; } }
	@keyframes cr-ha-clear { 0%, 17.8% { opacity: 1; } 18.3%, 63.8% { opacity: 0; } 64.3%, 100% { opacity: 1; } }
	@keyframes cr-ha-det { 0%, 17.8% { opacity: 0; } 18.3%, 63.8% { opacity: 1; } 64.3%, 100% { opacity: 0; } }
	@keyframes cr-ha-run { 0%, 33.6% { background: #5c5850; box-shadow: none; } 34%, 40% { background: #8fb8ff; box-shadow: 0 0 0 5px rgba(143, 184, 255, 0.18); } 46%, 100% { background: #8fb8ff; box-shadow: none; } }
	@keyframes cr-ha-clear-b { 0%, 33.6% { opacity: 1; } 34%, 98% { opacity: 0; } 99%, 100% { opacity: 1; } }
	@keyframes cr-ha-run-t { 0%, 33.6% { opacity: 0; } 34%, 98% { opacity: 1; } 99%, 100% { opacity: 0; } }
</style>
