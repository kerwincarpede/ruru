<style>
	@property --fx { syntax: '<color>'; inherits: true; initial-value: rgba(232, 183, 63, 0); }
	@property --chip { syntax: '<color>'; inherits: true; initial-value: #e8b73f; }
	@property --cap { syntax: '<color>'; inherits: true; initial-value: #ece9e3; }
	/* ---------- The camera wall ---------- */

	.rw { position: relative; width: 100%; height: 100%; overflow: hidden; background: #08090b; container-type: inline-size; color: #ece9e3; font-family: var(--ru-font-sans); }
	.rw * { box-sizing: border-box; }
	.rw-in { position: absolute; inset: 0.45cqw; animation: cr-rw-fade var(--loop) linear infinite; }

	.t { position: absolute; padding: 0.55cqw; }
	.t-fd { left: 0; top: 0; width: 50%; height: 66.667%; z-index: 8; animation: cr-fd-pos var(--loop) linear infinite, cr-fd-fx var(--loop) linear infinite; }
	.t-dw { left: 50%; top: 0; width: 25%; height: 33.333%; z-index: 5; animation: cr-dw-pos var(--loop) linear infinite; }
	.t-by { left: 75%; top: 0; width: 25%; height: 33.333%; z-index: 2; animation: cr-by-pos var(--loop) linear infinite, cr-by-fx var(--loop) linear infinite; }
	.t-ga { left: 50%; top: 33.333%; width: 25%; height: 33.333%; }
	.t-sg { left: 75%; top: 33.333%; width: 25%; height: 33.333%; }
	.t-po { left: 0; top: 66.667%; width: 50%; height: 33.333%; animation: cr-po-pos var(--loop) linear infinite; }
	.t-st { left: 50%; top: 66.667%; width: 50%; height: 33.333%; z-index: 1; animation: cr-st-pos var(--loop) linear infinite; }

	.pic { position: relative; width: 100%; height: 100%; overflow: hidden; border-radius: 0.55cqw; background: #1b2227; }
	.pic::after { content: ''; position: absolute; inset: 0; z-index: 1; pointer-events: none; background: radial-gradient(120% 95% at 50% 40%, transparent 55%, rgba(0, 0, 0, 0.5)), repeating-linear-gradient(0deg, rgba(255, 255, 255, 0.022) 0 1px, transparent 1px 3px); }
	.t-dw .pic { animation: cr-dw-lift var(--loop) linear infinite; }
	.scene { position: absolute; inset: 0; width: 100%; height: 100%; display: block; }

	.ts { position: absolute; left: 0.7cqw; top: 0.6cqw; z-index: 2; font: 500 0.9cqw/1 var(--ru-font-mono); letter-spacing: 0.02em; color: rgba(255, 255, 255, 0.7); text-shadow: 0 1px 2px #000; white-space: nowrap; }
	.cap { position: absolute; left: 0; right: 0; bottom: 0; z-index: 2; display: flex; align-items: center; gap: 0.6cqw; padding: 2.4cqw 0.9cqw 0.75cqw; background: linear-gradient(transparent, rgba(0, 0, 0, 0.7)); color: var(--cap); font-size: 1.4cqw; font-weight: 600; text-shadow: 0 1px 3px rgba(0, 0, 0, 0.8); white-space: nowrap; }
	.lv { flex: none; width: 0.65cqw; height: 0.65cqw; border-radius: 50%; background: #4ade80; box-shadow: 0 0 0.5cqw #4ade80; }
	.cap em { display: inline-block; max-width: 0; overflow: hidden; opacity: 0; font-style: normal; vertical-align: bottom; }
	.t-fd .cap em { animation: cr-fd-alert var(--loop) linear infinite; }

	.chips { position: absolute; right: 0.6cqw; top: 0.6cqw; z-index: 2; display: flex; gap: 0.4cqw; }
	.chip { display: block; padding: 0.5cqw 1cqw; border-radius: 99cqw; background: var(--chip); color: #0b0c0f; font: 700 1.25cqw/1 var(--ru-font-sans); box-shadow: 0 0 1.6cqw -0.2cqw var(--chip); opacity: 0; transform: scale(0.8); transform-origin: right center; }
	.t-fd .chip { animation: cr-fd-chip var(--loop) linear infinite; }
	.t-by .chip { animation: cr-by-chip var(--loop) linear infinite; }

	/* Activity marks: one per style; the wall's as-* class picks which shows. */
	.mk { position: absolute; z-index: 3; pointer-events: none; }
	.mk-o { inset: 0; border: 0.3cqw solid var(--fx); border-radius: 1.05cqw; box-shadow: 0 0 2.2cqw 0 var(--fx); }
	.mk-i { inset: 0; display: none; border: 0.15cqw solid var(--fx); border-radius: 0.55cqw; }
	.mk-c { display: none; width: 1.5cqw; height: 1.5cqw; border: 0 solid var(--fx); }
	.mk-c.c1 { left: 0.45cqw; top: 0.45cqw; border-top-width: 0.24cqw; border-left-width: 0.24cqw; border-top-left-radius: 0.3cqw; }
	.mk-c.c2 { right: 0.45cqw; top: 0.45cqw; border-top-width: 0.24cqw; border-right-width: 0.24cqw; border-top-right-radius: 0.3cqw; }
	.mk-c.c3 { left: 0.45cqw; bottom: 0.45cqw; border-bottom-width: 0.24cqw; border-left-width: 0.24cqw; border-bottom-left-radius: 0.3cqw; }
	.mk-c.c4 { right: 0.45cqw; bottom: 0.45cqw; border-bottom-width: 0.24cqw; border-right-width: 0.24cqw; border-bottom-right-radius: 0.3cqw; }
	.mk-t { left: 0; right: 0; top: 0; height: 0.3cqw; display: none; background: var(--fx); }
	.as-thin .mk-o, .as-corners .mk-o, .as-top .mk-o { display: none; }
	.as-thin .mk-i, .as-corners .mk-c, .as-top .mk-t { display: block; }
	.as-corners .chips, .as-top .chips { top: 1.1cqw; right: 1.1cqw; }

	/* Edit layout */
	.eo { position: absolute; inset: 0.55cqw; z-index: 4; border: 0.1cqw dashed rgba(255, 255, 255, 0.5); border-radius: 0.55cqw; opacity: 0; pointer-events: none; animation: cr-rw-edit var(--loop) linear infinite; }
	.eo::after { content: ''; position: absolute; right: -0.4cqw; bottom: -0.4cqw; width: 0.8cqw; height: 0.8cqw; border-radius: 0.2cqw; background: #ece9e3; box-shadow: 0 0 0 0.12cqw #08090b; }
	.rw-grid { position: absolute; inset: 0; z-index: 0; opacity: 0; pointer-events: none; animation: cr-rw-edit var(--loop) linear infinite; background-image: linear-gradient(to right, rgba(255, 255, 255, 0.07) 1px, transparent 1px), linear-gradient(to bottom, rgba(255, 255, 255, 0.07) 1px, transparent 1px); background-size: 12.5% 16.667%; }
	.rw-bar { position: absolute; left: 50%; top: 1.2cqw; z-index: 12; display: flex; align-items: center; gap: 1.1cqw; padding: 0.55cqw 0.6cqw 0.55cqw 1.2cqw; border: 1px solid rgba(255, 255, 255, 0.12); border-radius: 99cqw; background: rgba(30, 33, 40, 0.9); backdrop-filter: blur(8px); font-size: 1.02cqw; white-space: nowrap; opacity: 0; transform: translate(-50%, -0.6cqw); animation: cr-rw-bar var(--loop) linear infinite; box-shadow: 0 1cqw 3cqw rgba(0, 0, 0, 0.5); }
	.rw-bar b { font-weight: 650; }
	.rw-opt { display: inline-flex; align-items: center; gap: 0.4cqw; color: #cfc9bf; }
	.ck { width: 0.95cqw; height: 0.95cqw; border-radius: 0.22cqw; background: #e0a458; box-shadow: inset 0 0 0 0.16cqw #e0a458; }
	.ck.off { background: transparent; box-shadow: inset 0 0 0 0.12cqw #8b867d; }
	.rw-done { padding: 0.4cqw 1.1cqw; border-radius: 99cqw; background: #e8b73f; color: #08090b; font-weight: 650; animation: cr-rw-done var(--loop) linear infinite; }
	.rw-cur { position: absolute; left: 40%; top: 40%; z-index: 13; width: 2.1cqw; height: auto; opacity: 0; pointer-events: none; filter: drop-shadow(0 0.2cqw 0.4cqw rgba(0, 0, 0, 0.6)); animation: cr-rw-cur var(--loop) linear infinite; }
