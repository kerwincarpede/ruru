---
// The camera wall in the landing page's hero: seven made-up cameras drawn as
// night-time infrared scenes, playing one story on a loop. It shares the
// hero's timeline (--loop, set by ControlRoom.astro), so the MQTT feed and the
// Home Assistant card change in step with it:
//    2%  a cat crosses the back yard (motion, Cat chip)
//   10%  front door motion, 18% Person chip, 26% alert (red)
//   34%  Home Assistant maximises the front door, 58% restores the wall
//   64%  the person has gone, 70% motion ends
//   72-94% Edit layout: drag Driveway, resize Porch and Street, Done
//   97-100% the wall fades and starts again
// `activity` picks how tiles are marked, as Settings → Home Assistant →
// Activity style does: gap (Outline between tiles), thin, corners or top.

interface Props {
	activity?: 'gap' | 'thin' | 'corners' | 'top';
}

const { activity = 'gap' } = Astro.props;
---

<div class={`rw as-${activity}`} role="img" aria-label="Ruru's camera wall: a person walks up to the front door, the tile is marked for motion, a Person chip appears, then an alert turns it red and Home Assistant maximises it. Then the layout is edited.">
