---
// The landing page's hero: a TV on the wall running Ruru, the owl perched on
// top, Home Assistant on a phone and the MQTT messages in a terminal, all
// playing one story (see HeroWall.astro for the timeline).
//
// Hovering over the owl (or tapping it) tells where the name comes from: the
// page steps aside, night falls and the owl flies to the middle. Moving the
// pointer off the story, Back to the wall or Esc puts everything back. On a
// narrow screen the story opens over the page instead.
import Owl from '../Owl.astro';
import HeroWall from './HeroWall.astro';
import MqttFeed from './MqttFeed.astro';
import HaCard from './HaCard.astro';

const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<section class="cr" aria-labelledby="cr-title" data-cr>
	<div class="cr-night" aria-hidden="true">
		<div class="cr-stars"></div>
		<div class="cr-moon"></div>
		<svg class="cr-bush" viewBox="0 0 1440 320" preserveAspectRatio="none">
			<path class="h1" d="M0 210C180 160 360 190 560 172S900 140 1100 176 1350 160 1440 182V320H0z"></path>
			<path class="fern" d="M1180 250V150M1180 150c-30-6-56 4-78 24M1180 150c30-6 56 4 78 24M1180 150c-22-20-48-26-74-20M1180 150c22-20 48-26 74-20M1180 150c-6-24-2-44 8-60M220 262V178M220 178c-26-4-48 6-66 22M220 178c26-4 48 6 66 22M220 178c-18-18-40-22-62-16M220 178c18-18 40-22 62-16"></path>
			<path class="h2" d="M0 262C260 232 520 256 760 242S1180 226 1440 252V320H0z"></path>
		</svg>
	</div>

	<div class="cr-copy">
		<p class="cr-eyebrow"><span class="cr-dot"></span>A camera wall for <a href="https://frigate.video/">Frigate</a> · works with Home Assistant</p>
		<h1 id="cr-title" class="cr-h1">The wall that <em>keeps watch</em>.</h1>
		<p class="ru-lede">
			Every Frigate camera, live on a spare screen. When someone comes to the door, the tile lights up, and your Home Assistant
			automations can put that camera front and centre, then put the wall back.
		</p>
		<div class="cr-actions">
			<a class="ru-btn" href="#download">Download Ruru</a>
			<a class="ru-btn ru-btn--ghost" href={`${base}/get-started/`}>Read the guide</a>
		</div>
	</div>

	<div class="pc-scene">
		<div class="pc-par" data-cr-par>
			<div class="pc-tv">
				<button class="pc-owl" type="button" aria-expanded="false" aria-controls="cr-story" data-cr-owl>
					<span class="cr-sr">What's a ruru? Where the name comes from</span>
					<span class="pc-owl-bob"><Owl mood="awake" id="cr-owl-" class="on-wall" follow /></span>
					<svg class="pc-branch" viewBox="0 0 260 40" aria-hidden="true">
						<path d="M4 24C60 14 120 20 170 16S236 8 256 4"></path>
						<path d="M176 15c10-10 22-14 34-12"></path>
						<ellipse class="lf" cx="214" cy="4" rx="10" ry="4"></ellipse>
						<ellipse class="lf" cx="30" cy="26" rx="9" ry="3.5" transform="rotate(-12 30 26)"></ellipse>
					</svg>
				</button>
				<span class="pc-hint" aria-hidden="true">
					<svg viewBox="0 0 26 14"><path d="M1 3c8 0 16 2 22 8M23 11l-1-6M23 11l-6-1"></path></svg>What's a ruru?
				</span>
				<div class="pc-screen">
					<div class="pc-screen-in">
						<HeroWall />
					</div>
				</div>
				<button class="pc-pause" type="button" aria-pressed="false" data-cr-pause>Pause</button>
			</div>

			<div class="pc-call-wrap" aria-hidden="true">
				<span class="pc-call k1"><i></i>Frigate sees a person at the front door</span>
				<span class="pc-call k2"><i></i>Frigate raises an alert</span>
				<span class="pc-call k3"><i></i>Home Assistant maximised Front door</span>
				<span class="pc-call k4"><i></i>Edit layout: drag, resize, Done</span>
			</div>

			<div class="pc-term" aria-hidden="true">
				<div class="pc-term-h"><i></i><i></i><i></i><span>mosquitto_sub -h homeassistant.local -t 'frigate/#' -t 'ruru/#' -v</span></div>
				<MqttFeed />
			</div>

			<div class="pc-phone" aria-hidden="true">
				<div class="pc-phone-in">
					<div class="pc-phone-hd"><b>Hallway</b><span>Home Assistant</span></div>
					<HaCard />
				</div>
			</div>

			<section id="cr-story" class="pc-story" role="dialog" aria-modal="true" aria-labelledby="cr-story-title" inert data-cr-story>
				<div class="pc-story-owl" aria-hidden="true"><Owl mood="awake" id="cr-story-owl-" class="on-wall" follow /></div>
				<p class="pc-kick">Ruru · say “roo-roo” · te reo Māori</p>
				<h2 id="cr-story-title" tabindex="-1">Named after a small owl that keeps watch all night.</h2>
				<div class="pc-cols">
					<div class="pc-col">
						<small>The bird</small>
						<h3>New Zealand's own owl</h3>
						<p>
							The ruru, or morepork, is a small native owl found in forests all over New Zealand. It's heard far more often than seen,
							hunting through the night with <em>big yellow eyes</em>.
						</p>
					</div>
					<div class="pc-col">
						<small>The name</small>
						<h3>Named for its call</h3>
						<p>A soft two-note call carries through the bush after dark. Māori named the bird for it; English settlers heard “more-pork”.</p>
						<div class="rr-call" aria-hidden="true"><span>ru</span><i></i><span>ru</span></div>
					</div>
					<div class="pc-col">
						<small>The app</small>
						<h3>Why we chose it</h3>
						<p>A camera wall watches while everyone sleeps. So we named it after the bird that does the same, and gave it <em>the same eyes</em>.</p>
					</div>
				</div>
				<div><button class="pc-back" type="button" data-cr-back>Back to the wall</button></div>
			</section>
		</div>
	</div>

	<ol class="pc-steps" aria-label="What happens on the wall">
		<li class="pc-step s1"><small>01 · Frigate</small><h3>Someone comes to the door</h3><p>Frigate sees motion, then a person, and says so over MQTT.</p></li>
		<li class="pc-step s2"><small>02 · Ruru</small><h3>The tile lights up</h3><p>Yellow for motion, a <b>Person</b> chip, then red when Frigate raises an alert.</p></li>
		<li class="pc-step s3"><small>03 · Home Assistant</small><h3>Your automation reacts</h3><p>It can maximise the front door on the wall, and restore the wall when the alert ends.</p></li>
		<li class="pc-step s4"><small>04 · You</small><h3>Arrange it any time</h3><p>Choose <b>Edit layout</b>, drag and resize tiles, then choose <b>Done</b>. Ruru remembers.</p></li>
	</ol>
</section>

<script>
	const hero = document.querySelector<HTMLElement>('[data-cr]');
	const owl = hero?.querySelector<HTMLButtonElement>('[data-cr-owl]');
	const story = hero?.querySelector<HTMLElement>('[data-cr-story]');
	const back = hero?.querySelector<HTMLButtonElement>('[data-cr-back]');
	const par = hero?.querySelector<HTMLElement>('[data-cr-par]');

	const pause = hero?.querySelector<HTMLButtonElement>('[data-cr-pause]');
	const heading = story?.querySelector<HTMLElement>('h2');

	if (hero && owl && story && back && par && pause && heading) {
		/** The width at which the whole scene shows; narrower, the story opens over the page. */
		const wide = window.matchMedia('(min-width: 1000px)');
		const still = window.matchMedia('(prefers-reduced-motion: reduce)');
		let opening = 0;
		let closing = 0;
		let frame = 0;
		let tilt = { x: 0, y: 0 };
		/** False after the story closes, until the pointer leaves the owl, so the owl flying back under it doesn't reopen it. */
		let hoverArmed = true;

		// While the story is open, everything else on the page is out of reach,
		// as in a modal dialog: the page around the hero and the hero's own copy,
		// TV and steps.
		const outside = () => [
			...[...document.body.children].filter((element) => !element.contains(hero)),
			...[...(hero.closest('main')?.children ?? [])].filter((element) => element !== hero),
			...hero.querySelectorAll<HTMLElement>('.cr-copy, .pc-tv, .pc-steps'),
		];

		const isOpen = () => hero.classList.contains('is-story');
		const setOpen = (open: boolean, moveFocus = false) => {
			window.clearTimeout(opening);
			window.clearTimeout(closing);
			if (open === isOpen()) return;
			const hadFocus = story.contains(document.activeElement);
			hero.classList.toggle('is-story', open);
			hero.classList.remove('is-hint');
			owl.setAttribute('aria-expanded', String(open));
			for (const element of outside()) element.inert = open;
			story.inert = !open;
			if (open) tilt = { x: 0, y: 0 };
			applyTilt();
			if (open) heading.focus({ preventScroll: true });
			if (!open && (moveFocus || hadFocus)) owl.focus({ preventScroll: true });
			if (!open) hoverArmed = false;
		};

		// Hover: a short pause first, so passing over the owl doesn't open it.
		owl.addEventListener('pointerenter', (event) => {
			if (event.pointerType !== 'mouse' || !hoverArmed) return;
			hero.classList.add('is-hint');
			opening = window.setTimeout(() => setOpen(true), 260);
		});
		owl.addEventListener('pointerleave', () => {
			hoverArmed = true;
			window.clearTimeout(opening);
			hero.classList.remove('is-hint');
		});
		owl.addEventListener('click', () => setOpen(true, true));
		story.addEventListener('pointerenter', () => window.clearTimeout(closing));
		story.addEventListener('pointerleave', (event) => {
			if (event.pointerType !== 'mouse' || !wide.matches) return;
			closing = window.setTimeout(() => setOpen(false), 380);
		});
		back.addEventListener('click', () => setOpen(false, true));
		// Tab stays in the story while it's open: the heading and Back to the wall.
		story.addEventListener('keydown', (event) => {
			if (event.key !== 'Tab') return;
			event.preventDefault();
			(document.activeElement === back ? heading : back).focus();
		});
		document.addEventListener('keydown', (event) => {
			if (event.key === 'Escape' && isOpen()) setOpen(false, true);
		});

		// Pause stops the whole story at once, so the wall, the feed and the card stay in step.
		pause.addEventListener('click', () => {
			const paused = hero.classList.toggle('is-paused');
			pause.setAttribute('aria-pressed', String(paused));
			pause.textContent = paused ? 'Play' : 'Pause';
		});

		// The scene leans a little towards the pointer.
		function applyTilt() {
			frame = 0;
			par!.style.transform = wide.matches ? `rotateX(${(-tilt.y * 1.2).toFixed(2)}deg) rotateY(${(tilt.x * 2).toFixed(2)}deg)` : '';
		}
		hero.addEventListener(
			'pointermove',
			(event) => {
				if (event.pointerType !== 'mouse' || still.matches || isOpen()) return;
				const box = hero.getBoundingClientRect();
				tilt = { x: ((event.clientX - box.left) / box.width) * 2 - 1, y: ((event.clientY - box.top) / box.height) * 2 - 1 };
				if (!frame) frame = requestAnimationFrame(applyTilt);
			},
			{ passive: true },
		);
		hero.addEventListener('pointerleave', () => {
			tilt = { x: 0, y: 0 };
			if (!frame) frame = requestAnimationFrame(applyTilt);
		});
		wide.addEventListener('change', applyTilt);
	}
</script>

<style>
	@property --spill {
		syntax: '<color>';
		inherits: true;
		initial-value: rgba(224, 164, 88, 0.16);
	}

	/* The hero is night-time in both themes, so it brings its own dark colours. */
	.cr {
		--loop: 18s;
		--ru-text: #ece9e3;
		--ru-muted: #a19c92;
		--ru-hair: rgb(255 255 255 / 8%);
		--ru-hair-strong: rgb(255 255 255 / 16%);
		--ru-cta: linear-gradient(180deg, #f0bd77, #d18f3f);
		--ru-on-cta: #15171c;
		--ru-glow: rgb(224 164 88 / 30%);
		--ru-accent: #e0a458;
		position: relative;
		overflow: clip;
		background: #0a0b0e;
		color: var(--ru-text);
	}
	.cr::before {
		content: '';
		position: absolute;
		left: 0;
		right: 0;
		top: 480px;
		height: 900px;
		pointer-events: none;
		background: radial-gradient(42% 46% at 48% 42%, var(--spill), transparent 72%);
		opacity: 0.7;
		animation: cr-spill var(--loop) linear infinite;
	}
	.cr-sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}

	/* Copy */
	.cr-copy {
		position: relative;
		z-index: 3;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 4px;
		padding: clamp(32px, 5vw, 56px) clamp(16px, 4vw, 40px) 0;
		text-align: center;
	}
	.cr-eyebrow {
		display: inline-flex;
		flex-wrap: wrap;
		justify-content: center;
		align-items: center;
		gap: 4px 9px;
		margin: 0 0 18px;
		padding: 7px 14px 7px 11px;
		border: 1px solid rgb(255 255 255 / 14%);
		border-radius: 999px;
		background: rgb(255 255 255 / 3%);
		color: var(--ru-muted);
		font-size: 13.5px;
	}
	.cr-eyebrow a {
		color: #f3c88d;
		font-weight: 600;
		text-decoration-color: rgb(243 200 141 / 40%);
		text-underline-offset: 3px;
	}
	.cr-dot {
		width: 7px;
		height: 7px;
		flex: none;
		border-radius: 50%;
		background: #4ade80;
		box-shadow: 0 0 8px #4ade80;
		animation: cr-live 2.8s ease-in-out infinite;
	}
	.cr-h1 {
		margin: 0;
		font-size: clamp(42px, 6.4vw, 84px);
		line-height: 1;
		letter-spacing: -0.04em;
		font-weight: 650;
		text-wrap: balance;
	}
	.cr-h1 em {
		font-style: normal;
		color: #f3c88d;
	}
	.cr-actions {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin-top: 30px;
	}

	/* The scene: a fixed 1200 px stage, scaled down on smaller desktops. */
	.pc-scene {
		position: relative;
		z-index: 2;
		max-width: 1240px;
		height: 830px;
		margin: 40px auto 0;
		perspective: 2600px;
		perspective-origin: 50% 30%;
	}
	.pc-par {
		position: absolute;
		left: 50%;
		top: 0;
		width: 1200px;
		height: 830px;
		margin-left: -600px;
		transform-style: preserve-3d;
		transition: transform 1.4s cubic-bezier(0.2, 0.7, 0.2, 1);
	}

	/* The TV, mounted flat on the wall with the owl perched on top. */
	.pc-tv {
		position: absolute;
		left: 140px;
		top: 96px;
		width: 820px;
	}
	.pc-owl {
		position: absolute;
		right: 64px;
		top: -86px;
		z-index: 0;
		display: block;
		width: 176px;
		margin: 0;
		padding: 0;
		border: 0;
		border-radius: 40%;
		background: none;
		color: inherit;
		cursor: pointer;
	}
	.pc-owl-bob {
		display: block;
		animation: cr-owl var(--loop) linear infinite;
	}
	.pc-screen {
		position: relative;
		z-index: 1;
		aspect-ratio: 16 / 9;
		box-sizing: content-box;
		padding: 8px;
		border-radius: 14px;
		background: #050607;
		box-shadow: inset 0 0 0 1px rgb(255 255 255 / 9%), 0 0 0 1px #000, 0 40px 80px -24px rgb(0 0 0 / 95%), 0 0 160px -10px var(--spill);
		animation: cr-spill var(--loop) linear infinite;
	}
	.pc-screen-in {
		position: relative;
		width: 100%;
		height: 100%;
		overflow: hidden;
		border-radius: 6px;
	}
	.pc-screen-in::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: 20;
		pointer-events: none;
		background: linear-gradient(115deg, rgb(255 255 255 / 7%), transparent 32%, transparent 70%, rgb(255 255 255 / 2.5%));
	}

	.pc-phone {
		position: absolute;
		left: 964px;
		top: 236px;
		width: 236px;
		height: 480px;
		padding: 9px;
		border-radius: 40px;
		background: #0b0c0f;
		box-shadow: 0 0 0 1.5px #2b2e35, 0 0 0 4px #101114, 0 50px 90px -30px rgb(0 0 0 / 95%);
		rotate: y -10deg;
		transform-origin: left center;
		animation: cr-float 10s ease-in-out infinite alternate;
	}
	.pc-phone-in {
		height: 100%;
		overflow: hidden;
		padding: 22px 8px 8px;
		border-radius: 32px;
		background: #101216;
	}
	.pc-phone-hd {
		display: flex;
		align-items: baseline;
		justify-content: space-between;
		padding: 0 8px 12px;
	}
	.pc-phone-hd b {
		font-size: 17px;
		font-weight: 650;
		letter-spacing: -0.01em;
	}
	.pc-phone-hd span {
		color: var(--ru-muted);
		font-size: 11px;
	}
	.pc-phone :global(.ha) {
		padding: 12px;
		border-radius: 16px;
		box-shadow: none;
	}
	.pc-phone :global(.ha-r) {
		min-height: 36px;
		font-size: 12.5px;
	}
	.pc-phone :global(.ha-hd b) {
		font-size: 13.5px;
	}
	.pc-phone :global(.ha-auto) {
		font-size: 11.5px;
	}

	.pc-term {
		position: absolute;
		left: 0;
		top: 574px;
		width: 440px;
		rotate: y 8deg;
		transform-origin: right center;
		animation: cr-float 9s ease-in-out -4s infinite alternate;
	}
	.pc-term-h {
		display: flex;
		align-items: center;
		gap: 7px;
		padding: 0 0 8px 4px;
		color: var(--ru-muted);
		font: 500 11px/1 var(--ru-font-mono);
		white-space: nowrap;
		overflow: hidden;
	}
	.pc-term-h i {
		width: 9px;
		height: 9px;
		flex: none;
		border-radius: 50%;
		background: #2c3039;
	}
	.pc-term-h span {
		margin-left: 6px;
		overflow: hidden;
		text-overflow: ellipsis;
	}

	/* Callouts that point at the wall while the story plays. */
	.pc-call-wrap {
		position: absolute;
		inset: 0;
		pointer-events: none;
	}
	.pc-call {
		position: absolute;
		z-index: 6;
		display: flex;
		align-items: center;
		gap: 8px;
		padding: 8px 12px;
		border-radius: 999px;
		background: rgb(12 14 18 / 92%);
		border: 1px solid rgb(255 255 255 / 14%);
		color: #e7e2d9;
		font: 500 12.5px/1 var(--ru-font-sans);
		white-space: nowrap;
		box-shadow: 0 16px 40px -14px rgb(0 0 0 / 90%);
		opacity: 0;
	}
	.pc-call i {
		width: 8px;
		height: 8px;
		border-radius: 50%;
	}
	.pc-call.k1 {
		left: 40px;
		top: 214px;
		animation: cr-c1 var(--loop) linear infinite;
	}
	.pc-call.k1 i {
		background: #e8b73f;
		box-shadow: 0 0 10px #e8b73f;
	}
	.pc-call.k2 {
		left: 26px;
		top: 270px;
		animation: cr-c2 var(--loop) linear infinite;
	}
	.pc-call.k2 i {
		background: #f2555a;
		box-shadow: 0 0 10px #f2555a;
	}
	.pc-call.k3 {
		left: 420px;
		top: 22px;
		animation: cr-c3 var(--loop) linear infinite;
	}
	.pc-call.k3 i {
		background: #8fb8ff;
		box-shadow: 0 0 10px #8fb8ff;
	}
	.pc-call.k4 {
		left: 430px;
		top: 22px;
		animation: cr-c4 var(--loop) linear infinite;
	}
	.pc-call.k4 i {
		background: #ece9e3;
	}

	/* What happens, step by step, lit in time with the wall. */
	.pc-steps {
		position: relative;
		z-index: 3;
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
		gap: 14px;
		max-width: 1180px;
		margin: 0 auto;
		padding: 8px clamp(16px, 4vw, 32px) 72px;
		list-style: none;
		box-sizing: border-box;
	}
	.pc-step {
		position: relative;
		overflow: hidden;
		padding: 16px 18px 20px;
		border: 1px solid var(--ru-hair);
		border-radius: 14px;
		background: rgb(255 255 255 / 2.5%);
	}
	.pc-step small {
		display: block;
		color: #e0a458;
		font: 600 11px/1 var(--ru-font-mono);
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}
	.pc-step h3 {
		margin: 10px 0 6px;
		font-size: 15.5px;
		font-weight: 620;
	}
	.pc-step p {
		margin: 0;
		color: var(--ru-muted);
		font-size: 14px;
		line-height: 1.5;
	}
	.pc-step b {
		color: var(--ru-text);
		font-weight: 600;
	}
	.pc-step::after {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		height: 2px;
		width: 0;
	}
	.pc-step.s1 {
		animation: cr-s1 var(--loop) linear infinite;
	}
	.pc-step.s1::after {
		animation: cr-b1 var(--loop) linear infinite;
		background: #e8b73f;
	}
	.pc-step.s2 {
		animation: cr-s2 var(--loop) linear infinite;
	}
	.pc-step.s2::after {
		animation: cr-b2 var(--loop) linear infinite;
		background: #f2555a;
	}
	.pc-step.s3 {
		animation: cr-s3 var(--loop) linear infinite;
	}
	.pc-step.s3::after {
