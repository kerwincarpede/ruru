---
// A camera wall on a monitor, as Ruru draws it: tiles on the dark wall, each
// with the camera's name, and one tile showing stream info. The pictures are
// moving test patterns, never real camera video. A clock is burned in as a
// camera would, and one tile freezes now and then to show how Ruru marks a
// picture that has stopped moving.
const tiles = [
	{ name: 'Front door', pattern: 'bars', big: true, info: true },
	{ name: 'Driveway', pattern: 'ball' },
	{ name: 'Back garden', pattern: 'rings' },
	{ name: 'Side gate', pattern: 'sweep', stalls: true },
	{ name: 'Garage', pattern: 'checks' },
	{ name: 'Street', pattern: 'stripes' },
	{ name: 'Porch', pattern: 'ramp' },
	{ name: 'Shed', pattern: 'ball2' },
	{ name: 'Gate', pattern: 'rings2' },
];
---

<div class="monitor" role="img" aria-label="Ruru's camera wall on a monitor: nine live tiles of test patterns, the front door tile larger than the rest and showing its stream info.">
	<div class="wall" aria-hidden="true">
		{
			tiles.map((tile) => (
				<figure class:list={['tile', tile.big && 'is-big']} data-stalls={tile.stalls ? '' : undefined}>
					<div class:list={['pattern', `p-${tile.pattern}`]} />
					<span class="stamp" data-clock>2026-11-23 21:04:12</span>
					{tile.info && (
						<span class="info">
							<b>25.0 fps</b> · playing
							<br />
							WebRTC
							<br />
							front_door · 1920×1080
							<br />
							0 dropped / sample
						</span>
					)}
					<figcaption>
						{tile.name}
						{tile.stalls && <span class="status" data-status />}
					</figcaption>
				</figure>
			))
		}
	</div>
</div>

<script>
	const pad = (n: number) => String(n).padStart(2, '0');
	const stamp = (d: Date) =>
		`${d.getFullYear()}-${pad(d.getMonth() + 1)}-${pad(d.getDate())} ${pad(d.getHours())}:${pad(d.getMinutes())}:${pad(d.getSeconds())}`;

	// Every tile's clock ticks, except a stalled tile's, which keeps the time
	// its picture froze at while its caption counts how old the frame is.
	// It stalls for 6 seconds in every 16.
	const tick = () => {
		const now = new Date();
		const phase = Math.floor(now.getTime() / 1000) % 16;
		for (const tile of document.querySelectorAll<HTMLElement>('.tile')) {
			const clock = tile.querySelector<HTMLElement>('[data-clock]');
			const stalled = tile.hasAttribute('data-stalls') && phase >= 10;
			tile.classList.toggle('is-stale', stalled);
			const status = tile.querySelector<HTMLElement>('[data-status]');
			if (status) status.textContent = stalled ? ` · Reconnecting · ${phase - 9} s old` : '';
			if (clock && !stalled) clock.textContent = stamp(now);
		}
	};
	tick();
	setInterval(tick, 1000);
</script>

<style>
	.monitor {
		position: relative;
		padding: clamp(6px, 1.2vw, 14px);
		border-radius: clamp(14px, 2vw, 24px);
		background: linear-gradient(180deg, #2a2d34, #15171c);
		box-shadow:
			inset 0 1px 0 rgb(255 255 255 / 10%),
			0 40px 120px rgb(0 0 0 / 45%),
			0 0 0 1px rgb(255 255 255 / 6%);
	}
	.wall {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		gap: 4px;
		padding: 4px;
		border-radius: clamp(8px, 1.2vw, 14px);
		background: var(--ru-wall);
		overflow: hidden;
	}
	.tile {
		position: relative;
		margin: 0;
		aspect-ratio: 16 / 9;
		overflow: hidden;
		border-radius: 3px;
		background: #111;
		container-type: inline-size;
	}
	.tile.is-big {
		grid-column: span 2;
		grid-row: span 2;
	}
	.pattern {
		position: absolute;
		inset: 0;
		transition: filter 0.4s ease;
	}
	.tile.is-stale .pattern {
		filter: brightness(0.45) saturate(0.6);
		animation-play-state: paused;
	}
	.tile.is-stale .pattern::before,
	.tile.is-stale .pattern::after {
		animation-play-state: paused;
	}

	.stamp {
		position: absolute;
		top: 5%;
		left: 4%;
		font-family: var(--ru-font-mono);
		font-size: clamp(6px, 5.4cqi, 13px);
		color: #fff;
		text-shadow: 0 0 2px #000, 0 0 4px #000;
		letter-spacing: 0.02em;
		white-space: nowrap;
	}
	.is-big .stamp {
		font-size: clamp(8px, 3.4cqi, 15px);
	}
	figcaption {
		position: absolute;
		left: 4%;
		bottom: 5%;
		max-width: 92%;
		padding: 0.25em 0.6em;
		border-radius: 999px;
		background: var(--ru-chrome);
		color: var(--ru-on-wall);
		font-size: clamp(6px, 5.6cqi, 13px);
		font-weight: 550;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
	}
	.is-big figcaption {
		font-size: clamp(8px, 3.2cqi, 15px);
	}
	.status {
		color: #f2b631;
	}
	.info {
		position: absolute;
		top: 5%;
		right: 3%;
		padding: 0.45em 0.7em;
		border-radius: 6px;
		background: rgb(0 0 0 / 62%);
		color: #e8f0e8;
		font-family: var(--ru-font-mono);
		font-size: clamp(6px, 2.4cqi, 11px);
		line-height: 1.45;
	}
	.info b {
		color: #fff;
		font-weight: 600;
	}

	/* Test patterns */
	.p-bars {
		background:
			linear-gradient(90deg, #c0c0c0 0 14.28%, #c0c000 0 28.57%, #00c0c0 0 42.85%, #00c000 0 57.14%, #c000c0 0 71.42%, #c00000 0 85.71%, #0000c0 0) top / 100% 67% no-repeat,
			linear-gradient(90deg, #0000c0 0 14.28%, #131313 0 28.57%, #c000c0 0 42.85%, #131313 0 57.14%, #00c0c0 0 71.42%, #131313 0 85.71%, #c0c0c0 0) 0 67% / 100% 8% no-repeat,
			linear-gradient(90deg, #00214c 0 18%, #fff 0 36%, #32006a 0 54%, #131313 0 100%) bottom / 100% 25% no-repeat;
	}
	.p-bars::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		width: 6%;
		background: linear-gradient(90deg, transparent, rgb(255 255 255 / 35%), transparent);
		animation: sweep 4s linear infinite;
	}

	.p-ball,
	.p-ball2 {
		background:
			linear-gradient(rgb(255 255 255 / 10%) 1px, transparent 1px) 0 0 / 12.5% 22.2%,
			linear-gradient(90deg, rgb(255 255 255 / 10%) 1px, transparent 1px) 0 0 / 12.5% 22.2%,
			#14324a;
	}
	.p-ball2 {
		background-color: #3a2240;
	}
	.p-ball::after,
	.p-ball2::after {
		content: '';
		position: absolute;
		width: 18%;
		aspect-ratio: 1;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 35%, #fff, #e0a458 45%, #8a5523);
		animation: bounce-x 3.1s ease-in-out infinite alternate, bounce-y 1.3s ease-in infinite alternate;
	}
	.p-ball2::after {
		background: radial-gradient(circle at 35% 35%, #fff, #7dd3fc 45%, #1d4ed8);
		animation-duration: 2.3s, 1.7s;
	}

	.p-rings,
	.p-rings2 {
		background: repeating-radial-gradient(circle at 50% 50%, #1b3a2a 0 6%, #2f6b4a 6% 12%);
		animation: pulse 3s ease-in-out infinite alternate;
	}
	.p-rings2 {
		background: repeating-radial-gradient(circle at 50% 50%, #3a2a14 0 6%, #7a5520 6% 12%);
		animation-duration: 4.2s;
	}

	.p-sweep {
		background: linear-gradient(90deg, #000, #fff);
	}
	.p-sweep::after {
		content: '';
		position: absolute;
		top: 0;
		bottom: 0;
		width: 4%;
		background: #e11d48;
		animation: sweep 2.6s linear infinite;
	}

	.p-checks {
		background: repeating-conic-gradient(#242830 0 25%, #4b5160 0 50%) 0 0 / 16% 28%;
		animation: drift 6s linear infinite;
	}

	.p-stripes {
		background: repeating-linear-gradient(45deg, #1e293b 0 10px, #334155 10px 20px);
		background-size: 200% 200%;
		animation: slide 5s linear infinite;
	}

	.p-ramp {
		background:
			linear-gradient(#0000 50%, #0008 50%),
			linear-gradient(90deg, #f00, #ff0, #0f0, #0ff, #00f, #f0f, #f00);
		background-size: 100% 100%, 200% 100%;
		animation: hue 8s linear infinite;
	}

	@keyframes sweep {
		from {
			left: -6%;
		}
		to {
			left: 100%;
		}
	}
	@keyframes bounce-x {
		from {
			left: 2%;
		}
		to {
			left: 80%;
		}
	}
	@keyframes bounce-y {
		from {
			top: 4%;
		}
		to {
			top: 64%;
		}
	}
	@keyframes pulse {
		from {
			background-size: 100% 100%;
		}
		to {
			background-size: 140% 140%;
		}
	}
	@keyframes drift {
		to {
			background-position: 32% 56%;
		}
	}
	@keyframes slide {
		to {
			background-position: 56px 56px;
		}
	}
	@keyframes hue {
		to {
			background-position: 0 0, 200% 0;
		}
	}

	@media (max-width: 560px) {
		.wall {
			grid-template-columns: repeat(2, 1fr);
		}
		.tile:nth-child(n + 6) {
			display: none;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.pattern,
		.pattern::before,
		.pattern::after {
			animation: none !important;
		}
		.p-ball::after,
		.p-ball2::after {
			left: 40%;
			top: 30%;
		}
		.p-sweep::after,
		.p-bars::after {
			left: 48%;
		}
	}
</style>
