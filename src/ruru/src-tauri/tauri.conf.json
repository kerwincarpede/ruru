{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Ruru",
  "version": "0.1.0",
  "identifier": "com.kerwincarpede.ruru",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Ruru",
        "width": 960,
        "height": 640,
        "minWidth": 480,
        "minHeight": 360
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "A low-latency camera wall for Frigate",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEZBRTZERTdDOUEzNEE4QkUKUldTK3FEU2FmTjdtK3E0ajUvSnVxS0d5UHBFR3hqQjdWK0xhR3JhamJIam1NS2o0a3BqY2ZmenkK",
      "endpoints": [
        "https://github.com/kerwincarpede/ruru/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
